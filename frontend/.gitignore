# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Contentlayer
.contentlayer
# Clerk configuration (can include secrets)
/.clerk/

# Generated by `next dev` (#611). `agentRules: false` in next.config.ts stops
# them being written; these lines are the second line of defence, so a future
# Next version that regenerates them anyway cannot be swept in by `git add -A`.
# frontend/CLAUDE.md in particular would be read as project instructions by any
# agent session started in this directory, competing with the root CLAUDE.md.
/AGENTS.md
/CLAUDE.md
