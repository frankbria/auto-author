[run]
source = app
omit =
    */tests/*
    */migrations/*
    */venv/*
    */env/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise NotImplementedError
    if __name__ == .__main__.:
    # Anchored: the bare `pass` matched "bypass" and left the BYPASS_AUTH validator out (#841).
    ^\s*pass\s*$
    raise ImportError
