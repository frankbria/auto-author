# Deployment marker (Required). One of development, test, staging, production.
# There is no default: the app refuses to start without it, because the
# production guards (BYPASS_AUTH block, weak-secret checks) key off it (#777).
ENVIRONMENT=development

# Database settings (#845). DATABASE_NAME must be the frontend's DATABASE_NAME:
# better-auth writes the sessions there and this backend reads them, so two
# names means every API call is answered 401. Tests use their own database
# (TEST_MONGO_URI), not this one.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=auto_author

# For MongoDB Atlas (cloud production):
# Use mongodb+srv:// protocol which automatically enables TLS/SSL
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
# Note: SSL/TLS is automatically configured using the certifi package for certificate validation
# This ensures secure connections and compatibility with Python 3.13+ strict SSL requirements

# CORS Settings
# Can be a comma-separated string or JSON array
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# OpenAI API key (Required for the AI features; the rest of the app runs without it)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# AI provider and models (issue #917, Optional). Leave all unset to use OpenAI
# with gpt-4o for every flow (gpt-4 is retired, #1205). AI_BASE_URL points the client at any
# OpenAI-compatible endpoint (z.ai, OpenRouter, vLLM, Ollama: http://localhost:11434/v1).
# It is the only routing switch; the SDK's OPENAI_BASE_URL is ignored.
# AI_API_KEY, when set, takes precedence over OPENAI_API_KEY. It is required
# whenever AI_BASE_URL is set: the OpenAI key is never sent to another endpoint.
# DEFAULT = analysis, questions, enhance/transform; LONG_OUTPUT = drafts and TOC.
# The MAX_OUTPUT_TOKENS caps must not exceed the chosen model's output limit.
# The privacy policy names OpenAI and describes its API terms (#788): a non-empty
# AI_BASE_URL sends user content to another provider, so update the policy first.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_DEFAULT=gpt-4o
AI_MODEL_LONG_OUTPUT=gpt-4o
AI_MAX_OUTPUT_TOKENS_DEFAULT=4000
AI_MAX_OUTPUT_TOKENS_LONG=8000
# Reasoning models (Nemotron, Qwen3, GLM thinking) spend part of max_tokens on
# hidden reasoning. This many tokens are added to every flow's budget, still
# clamped by the caps above, so raise the caps with it (#925). 0 = off.
AI_REASONING_HEADROOM_TOKENS=0
# Seconds one request to the AI provider may take before it is abandoned and
# retried. The call holds a worker thread while it waits. Default 120.
# AI_REQUEST_TIMEOUT_SECONDS=120

# Better Auth Configuration (Required)
# CRITICAL: BETTER_AUTH_SECRET is required and must be a strong random value
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# NEVER use default/weak values - application will reject them
# Minimum 32 characters, recommended 64+ for production
BETTER_AUTH_SECRET=your-secure-secret-key-here-replace-with-generated-value
# Base URL of the application (must match frontend URL)
BETTER_AUTH_URL=http://localhost:3000

# API Settings
API_V1_PREFIX=/api/v1

# E2E Testing Settings
# WARNING: NEVER enable in production - application will refuse to start
# Only for development/test environments to bypass authentication in E2E tests
# When enabled, all API endpoints return a mock test user without requiring JWT
BYPASS_AUTH=false
# Purpose-built opt-in required alongside BYPASS_AUTH in EVERY non-production
# environment (#307): BYPASS_AUTH=true alone is coerced off with a warning.
# Only the exact value 1 counts. Never set in real deploys (production stays
# hard-blocked regardless).
E2E_ALLOW_BYPASS=0

# Designated staging E2E test account(s), comma-separated emails. The staging
# E2E suite signs in as ONE real user (BYPASS_AUTH off — it tests real auth) and
# legitimately exceeds human per-user limits, so these accounts skip the rate
# limiter (#180) / AI quota (#173) / entitlement gate. FENCED to non-production
# in code; leave empty in local/dev and never set it in production.
E2E_EXEMPT_EMAILS=

# Plan/entitlement enforcement (issue #174). When true, AI endpoints check the
# caller's plan against the entitlement registry. Free beta users get full
# access, so this is safe to leave on; bypassed alongside BYPASS_AUTH.
PLAN_ENFORCEMENT_ENABLED=true

# Upload storage (#806). One provider is used: Cloudinary if all three of its
# values are set, else S3 if AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
# AWS_S3_BUCKET are all set, else the local `uploads/` directory. Half a
# provider's values count as none. Local disk is for development: production
# refuses to start on it, and in the container image `uploads/` cannot be
# created, so every upload fails there until a provider is configured.

# AWS Settings (Optional - for transcription and S3 storage)
# Get from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloudinary Settings (Optional - for image storage)
# Get from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe billing (issues #220/#221, Optional until paid launch)
# In production /health fails unless all three STRIPE_* values below are set,
# or BILLING_ENABLED=false says this deployment sells nothing on purpose (#807).
# BILLING_ENABLED only changes what /health reports; it does not switch routes off.
BILLING_ENABLED=true
# STRIPE_WEBHOOK_SECRET verifies webhook payloads (raw-body HMAC); leave empty
# to keep POST /api/v1/webhooks/stripe failing closed (503).
# Get from: https://dashboard.stripe.com/webhooks (signing secret, whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe price id that maps subscribers to the "pro" plan. Must be a recurring,
# fixed-amount price: the auto-renewal disclosure (#770) is rendered from it.
# Checkout requires ToS consent, so the Stripe Dashboard needs a Terms of service
# URL (Settings -> Public details) or every checkout fails with 502.
STRIPE_PRICE_ID_PRO=
# Stripe API secret key (sk_test_.../sk_live_...) used by POST /api/v1/billing/checkout;
# leave empty to keep checkout failing closed (503).
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe Tax on checkout (#783). Checkout always collects a billing address and
# tax IDs; this turns on tax calculation. Enable it ONLY after Stripe Tax is set
# up in the Dashboard (Tax -> origin address, tax registrations), because Stripe
# rejects every checkout with automatic tax on an account where it isn't active.
STRIPE_AUTOMATIC_TAX=false
# Stripe Managed Payments (#1234): Stripe, selling as Link, is merchant of record
# and handles sales tax, fraud and disputes. Sent on every checkout either way, so
# the Dashboard default never decides it. When true it supersedes
# STRIPE_AUTOMATIC_TAX. Enable it ONLY after Managed Payments is activated in the
# Dashboard and the Pro product has an eligible tax code, or Stripe rejects checkout.
STRIPE_MANAGED_PAYMENTS=false

# Maximum number of retry attempts for failed AI service calls
# The service uses exponential backoff between retries
# Default: 3
AI_MAX_RETRIES=3

# Error tracking (issue #334, Optional). Unset => Sentry is inert (no events
# sent). Set in staging/production to route unhandled 500s to Sentry instead of
# PM2 stdout. Get from: Sentry project settings -> Client Keys (DSN).
# What is sent (#808): an unhandled error or a 5xx a route raises, its stack and the request's method,
# path and headers, with the cookie filtered and the referer removed. Not sent:
# frame locals, the request body, the query string, any log line. The release
# is the image's commit (GIT_SHA, set by the image build, not here).
SENTRY_DSN=
